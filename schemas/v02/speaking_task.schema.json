{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-ielts.internal/schemas/v02/speaking_task.schema.json",
  "title": "IELTSSpeakingTask",
  "description": "Normalized Speaking prompt, cue card, and sample speech response.",
  "type": "object",
  "properties": {
    "speaking_id": {
      "type": "string",
      "pattern": "^SP-[A-Z0-9-]+-PART[123]-\\d{3}$"
    },
    "test_id": {
      "type": ["string", "null"],
      "pattern": "^TEST-IELTS-[A-Z0-9]+-\\d{2}-(ACAD|GT)$"
    },
    "part": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "prompt_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cue_card_bullet_points": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "sample_transcript": {
      "type": ["string", "null"]
    },
    "target_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": ["extracted", "review_required", "reviewed", "verified", "rejected"]
    },
    "_provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "speaking_id",
    "part",
    "topic",
    "prompt_questions",
    "target_vocabulary",
    "verification_status",
    "_provenance"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "speaking_id": "SP-VOL99-PART2-001",
      "test_id": "TEST-IELTS-VOL99-01-ACAD",
      "part": 2,
      "topic": "Describe an environmental project you participated in",
      "prompt_questions": [
        "Describe an environmental project you participated in."
      ],
      "cue_card_bullet_points": [
        "What the project was",
        "Where it took place",
        "What you did specifically",
        "Explain how you felt about the experience"
      ],
      "sample_transcript": "I would like to talk about a community reforestation project...",
      "target_vocabulary": ["biodiversity", "ecological footprint", "reforestation"],
      "verification_status": "reviewed",
      "_provenance": {
        "schema_version": "v0.2.0-normalized",
        "source_file_id": "SRC-995",
        "source_legacy_id": "SRC-995",
        "relative_path": "private/raw/SYNTHETIC_VOL/speaking_cards.pdf",
        "source_sha256": "ca495991b7852b855e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934",
        "processing_unit": "page",
        "unit_identifier": "page_0003",
        "raw_block_locator": "para:2",
        "extractor_adapter": "pdf_native",
        "extractor_version": "0.1.0-pdfminer",
        "normalizer_version": "0.2.0-alpha",
        "normalized_at": "2026-11-19T12:00:00Z"
      }
    }
  ]
}
