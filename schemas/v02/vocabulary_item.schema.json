{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-ielts.internal/schemas/v02/vocabulary_item.schema.json",
  "title": "VocabularyItem",
  "description": "Normalized academic vocabulary or collocation entry grounded in authentic IELTS contexts.",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^(VOC|COL)-[A-Z0-9]+-\\d{5}$"
    },
    "entry_type": {
      "type": "string",
      "enum": ["vocabulary", "collocation"]
    },
    "lemma_or_expression": {
      "type": "string",
      "minLength": 2
    },
    "pos": {
      "type": "string",
      "enum": ["noun", "verb", "adjective", "adverb", "phrase", "idiom"]
    },
    "cambridge_us_ipa": {
      "type": "string",
      "description": "Cambridge Dictionary US International Phonetic Alphabet representation"
    },
    "meaning_vi": {
      "type": "string",
      "minLength": 2,
      "description": "Accurate explanation in Vietnamese"
    },
    "cefr_level": {
      "type": "string",
      "enum": ["B1", "B2", "C1", "C2"]
    },
    "context_sentence_en": {
      "type": "string",
      "minLength": 10,
      "description": "Authentic example sentence illustrating usage"
    },
    "collocations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_passage_id": {
      "type": ["string", "null"]
    },
    "quality_profile": {
      "$ref": "quality_profile.schema.json"
    },
    "_provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "item_id",
    "entry_type",
    "lemma_or_expression",
    "pos",
    "cambridge_us_ipa",
    "meaning_vi",
    "cefr_level",
    "context_sentence_en",
    "collocations",
    "quality_profile",
    "_provenance"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "item_id": "VOC-ACAD-00001",
      "entry_type": "vocabulary",
      "lemma_or_expression": "resilient",
      "pos": "adjective",
      "cambridge_us_ipa": "/rɪˈzɪl.jənt/",
      "meaning_vi": "có khả năng phục hồi nhanh chóng, kiên cường chống chịu",
      "cefr_level": "C1",
      "context_sentence_en": "The newly formulated composite proved far more resilient to environmental degradation than conventional plastics.",
      "collocations": ["resilient material", "highly resilient", "remain resilient"],
      "source_passage_id": "PASSAGE-VOL99-01-RD01",
      "quality_profile": {
        "lifecycle_status": "verified",
        "extraction_quality": "complete_clean",
        "source_fidelity": "authoritative_official",
        "answer_verification": "authoritative_key",
        "explanation_verification": "expert_verified",
        "publication_permission": "public_synthetic",
        "validation_flags": []
      },
      "_provenance": {
        "schema_version": "v0.2.0-normalized",
        "source_file_id": "FILE-e3b0c44298fc",
