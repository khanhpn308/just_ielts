{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-ielts.internal/schemas/v02/answer.schema.json",
  "title": "IELTSAnswer",
  "description": "Normalized ground truth answer key and verified variants, supporting orphaned keys and missing answers without data invention.",
  "type": "object",
  "properties": {
    "answer_id": {
      "type": "string",
      "pattern": "^ANS-[A-Z0-9-]+-(KEY|ALT\\d{2})$"
    },
    "question_id": {
      "type": ["string", "null"],
      "pattern": "^Q-[A-Z0-9-]+-(RD|LS|WR|SP)-\\d{3}$",
      "description": "Associated question ID. Null for orphaned answer keys where question booklet is missing."
    },
    "target_value": {
      "type": ["string", "null"],
      "description": "Primary authoritative answer string. Null if key is unrecorded or cut off in source."
    },
    "acceptable_alternates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "case_sensitive": {
      "type": "boolean",
      "default": false
    },
    "source_key_ref": {
      "type": "string",
      "description": "Document page, sheet name, or cell coordinate citing the answer key"
    },
    "quality_profile": {
      "$ref": "quality_profile.schema.json"
    },
    "_provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "answer_id",
    "acceptable_alternates",
    "case_sensitive",
    "source_key_ref",
    "quality_profile",
    "_provenance"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "answer_id": "ANS-VOL99-01-RD-001-KEY",
      "question_id": "Q-VOL99-01-RD-001",
      "target_value": "TRUE",
      "acceptable_alternates": ["T"],
      "case_sensitive": false,
      "source_key_ref": "Key Sheet 1, Cell B3",
      "quality_profile": {
        "lifecycle_status": "verified",
        "extraction_quality": "complete_clean",
        "source_fidelity": "authoritative_official",
        "answer_verification": "authoritative_key",
        "explanation_verification": "source_provided",
        "publication_permission": "public_synthetic",
        "validation_flags": []
      },
      "_provenance": {
        "schema_version": "v0.2.0-normalized",
        "source_file_id": "FILE-f4c8996fb924",
        "source_legacy_id": "SRC-998",
        "relative_path": "private/raw/SYNTHETIC_VOL/key.xlsx",
        "source_sha256": "f4c8996fb92427ae41e4649b934ca495991b7852b855e3b0c44298fc1c149afb",
        "processing_unit": "sheets",
        "unit_identifier": "raw_sheets",
        "raw_block_locator": "sheet:Test 1, cell:B3",
        "extractor_adapter": "xlsx",
        "extractor_version": "0.1.0-lxml-xlsx",
        "normalizer_version": "0.2.0-alpha",
        "canonical_content_sha256": null,
        "normalized_at": "2026-11-19T12:00:00Z"
      }
    },
    {
      "answer_id": "ANS-VOL99-01-RD-001-KEY",
      "question_id": null,
      "target_value": "FALSE",
