{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-ielts.internal/schemas/v02/evidence.schema.json",
  "title": "IELTSEvidence",
  "description": "Normalized textual or auditory grounding proof supporting an answer, including direct support, contradictory evidence, and NOT GIVEN absence-of-evidence reasoning.",
  "type": "object",
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EVID-[A-Z0-9-]+-\\d{2}$"
    },
    "answer_id": {
      "type": ["string", "null"],
      "pattern": "^ANS-[A-Z0-9-]+-(KEY|ALT\\d{2})$",
      "description": "Associated answer ID. Nullable for unlinked or orphan evidence."
    },
    "passage_id": {
      "type": ["string", "null"],
      "pattern": "^(PASSAGE|SECTION)-[A-Z0-9-]+-(RD|LS)\\d{2}$",
      "description": "Associated passage ID. Nullable if unlinked."
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "direct_support",
        "contradictory_evidence",
        "insufficient_information_not_given"
      ],
      "description": "Epistemic nature of the evidence: positive proof, contradiction (for FALSE), or absence/insufficiency (for NOT GIVEN)."
    },
    "paragraph_label": {
      "type": ["string", "null"],
      "description": "Paragraph letter anchor (e.g. 'B', 'Paragraph 3') or null."
    },
    "char_start": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Character start offset in passage narrative_text. Null if unresolved or for NOT GIVEN."
    },
    "char_end": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Character end offset in passage narrative_text. Null if unresolved or for NOT GIVEN."
    },
    "verbatim_quote": {
      "type": ["string", "null"],
      "description": "Exact quoted sentence from passage proving or contradicting proposition. Null for NOT GIVEN."
    },
    "exact_match_verified": {
      "type": "boolean",
      "default": false,
      "description": "True if verbatim_quote matches narrative_text[char_start:char_end] exactly."
    },
    "missing_information_rationale": {
      "type": ["string", "null"],
      "description": "Explicit pedagogical justification explaining what specific information is absent from the text for NOT GIVEN."
    },
    "audio_interval": {
      "type": ["object", "null"],
      "properties": {
        "start_sec": {
          "type": "number",
          "minimum": 0
        },
        "end_sec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["start_sec", "end_sec"],
      "additionalProperties": false
    },
    "quality_profile": {
      "$ref": "quality_profile.schema.json"
    },
    "_provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "evidence_id",
    "evidence_type",
    "exact_match_verified",
    "quality_profile",
    "_provenance"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "evidence_id": "EVID-VOL99-01-RD-001-01",
      "answer_id": "ANS-VOL99-01-RD-001-KEY",
      "passage_id": "PASSAGE-VOL99-01-RD01",
      "evidence_type": "direct_support",
      "paragraph_label": "B",
      "char_start": 320,
