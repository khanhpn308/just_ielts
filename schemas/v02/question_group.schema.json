{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-ielts.internal/schemas/v02/question_group.schema.json",
  "title": "QuestionGroup",
  "description": "Normalized instruction block clustering related question items.",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "pattern": "^QG-[A-Z0-9-]+-G\\d{2}$"
    },
    "passage_id": {
      "type": ["string", "null"],
      "pattern": "^(PASSAGE|SECTION)-[A-Z0-9-]+-(RD|LS)\\d{2}$",
      "description": "Parent passage/section ID. Nullable for standalone question groups."
    },
    "start_question_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "end_question_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "question_type": {
      "type": "string",
      "enum": [
        "true-false-not-given",
        "yes-no-not-given",
        "multiple-choice-single",
        "multiple-choice-multi",
        "matching-information",
        "matching-headings",
        "matching-features",
        "matching-sentence-endings",
        "sentence-completion",
        "summary-completion",
        "note-completion",
        "table-completion",
        "flow-chart-completion",
        "diagram-label-completion",
        "short-answer"
      ]
    },
    "instruction_text": {
      "type": "string",
      "minLength": 5
    },
    "word_limit_rule": {
      "type": ["string", "null"],
      "enum": [
        "one_word_only",
        "no_more_than_two_words",
        "no_more_than_three_words",
        "one_word_and_or_a_number",
        "no_more_than_two_words_and_or_a_number",
        "no_more_than_three_words_and_or_a_number",
        "a_number",
        "letters_only",
        null
      ]
    },
    "shared_options": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": ["label", "text"],
        "additionalProperties": false
      }
    },
    "quality_profile": {
      "$ref": "quality_profile.schema.json"
    },
    "_provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "group_id",
    "start_question_number",
    "end_question_number",
    "question_type",
    "instruction_text",
    "quality_profile",
    "_provenance"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "group_id": "QG-VOL99-01-RD01-G01",
      "passage_id": "PASSAGE-VOL99-01-RD01",
      "start_question_number": 1,
      "end_question_number": 6,
      "question_type": "true-false-not-given",
      "instruction_text": "Do the following statements agree with the information given in Reading Passage 1?",
      "word_limit_rule": null,
      "shared_options": null,
      "quality_profile": {
        "lifecycle_status": "reviewed",
        "extraction_quality": "complete_clean",
        "source_fidelity": "authoritative_official",
        "answer_verification": "authoritative_key",
        "explanation_verification": "source_provided",
        "publication_permission": "public_synthetic",
        "validation_flags": []
      },
      "_provenance": {
        "schema_version": "v0.2.0-normalized",
        "source_file_id": "FILE-e3b0c44298fc",
        "source_legacy_id": "SRC-999",
        "relative_path": "private/raw/SYNTHETIC_VOL/reading_sample.docx",
        "source_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "processing_unit": "document",
        "unit_identifier": "raw_document",
        "raw_block_locator": "para_index:10",
        "extractor_adapter": "docx",
        "extractor_version": "0.1.0-lxml-docx",
        "normalizer_version": "0.2.0-alpha",
        "canonical_content_sha256": null,
        "normalized_at": "2026-11-19T12:00:00Z"
      }
    }
  ]
}
