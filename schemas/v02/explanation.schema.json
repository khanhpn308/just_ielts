{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-ielts.internal/schemas/v02/explanation.schema.json",
  "title": "IELTSExplanation",
  "description": "Normalized pedagogical rationale, distractor analysis, and lexical paraphrase mapping.",
  "type": "object",
  "properties": {
    "explanation_id": {
      "type": "string",
      "pattern": "^EXPL-[A-Z0-9-]+$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^Q-[A-Z0-9-]+-(RD|LS)-\\d{3}$"
    },
    "answer_id": {
      "type": "string",
      "pattern": "^ANS-[A-Z0-9-]+-KEY$"
    },
    "evidence_id": {
      "type": ["string", "null"],
      "pattern": "^EVID-[A-Z0-9-]+-\\d{2}$"
    },
    "rationale_en": {
      "type": ["string", "null"],
      "description": "Pedagogical explanation in English"
    },
    "rationale_vi": {
      "type": ["string", "null"],
      "description": "Pedagogical explanation in Vietnamese"
    },
    "paraphrase_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prompt_term": {
            "type": "string"
          },
          "passage_term": {
            "type": "string"
          }
        },
        "required": ["prompt_term", "passage_term"],
        "additionalProperties": false
      }
    },
    "distractor_notes": {
      "type": ["string", "null"]
    },
    "author_type": {
      "type": "string",
      "enum": ["source_published", "expert_teacher", "machine_drafted"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["extracted", "review_required", "reviewed", "verified", "rejected"]
    },
    "_provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "explanation_id",
    "question_id",
    "answer_id",
    "paraphrase_map",
    "author_type",
    "verification_status",
    "_provenance"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "explanation_id": "EXPL-VOL99-01-RD-001",
      "question_id": "Q-VOL99-01-RD-001",
      "answer_id": "ANS-VOL99-01-RD-001-KEY",
      "evidence_id": "EVID-VOL99-01-RD-001-01",
      "rationale_en": "Paragraph B states that early formulations lacked elasticity and fractured easily, which directly confirms that they were more brittle.",
      "rationale_vi": "Đoạn B khẳng định các công thức đời đầu thiếu độ đàn hồi và dễ nứt gãy, hoàn toàn đồng nghĩa với việc chúng giòn hơn.",
      "paraphrase_map": [
        {
          "prompt_term": "more brittle",
          "passage_term": "lacked elasticity and fractured easily"
        }
      ],
      "distractor_notes": null,
      "author_type": "source_published",
      "verification_status": "verified",
      "_provenance": {
        "schema_version": "v0.2.0-normalized",
        "source_file_id": "SRC-997",
        "source_legacy_id": "SRC-997",
        "relative_path": "private/raw/SYNTHETIC_VOL/explanation_book.pdf",
        "source_sha256": "41e4649b934ca495991b7852b855e3b0c44298fc1c149afbf4c8996fb92427ae",
        "processing_unit": "page",
        "unit_identifier": "page_0005",
        "raw_block_locator": "para:3",
        "extractor_adapter": "pdf_ocr",
        "extractor_version": "0.1.0-tesseract-pdftoppm",
        "normalizer_version": "0.2.0-alpha",
        "normalized_at": "2026-11-19T12:00:00Z"
      }
    }
  ]
}
